{
  "name": "xgrok-client-web",
  "version": "1.1.6",
  "description": "xgrok客户端web版",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev:web-client": "dotenv -e .env.browser -- npx babel-node src/main.js",
    "build:web-client": "rm -rf web && cd ../xgrok-client && npm run build:brower && cp -rpf dist ../xgrok-client-web/web && cd ../xgrok-client-web && rm -rf dist && babel src -d dist",
    "prod": "export NODE_ENV=production&&node dist/main.js"
  },
  "license": "GPL-3.0",
  "author": "isaac <xhgainxq@qq.com>",
  "dependencies": {
    "koa": "^2.11.0",
    "koa-body": "^4.1.1",
    "koa-router": "^7.4.0",
    "koa-send": "^5.0.0",
    "koa-static": "^5.0.0",
    "koa-swagger-decorator": "^1.8.6",
    "koa2-cors": "^2.0.6",
    "oauth2-server": "^3.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.7",
    "@babel/node": "^7.20.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.20.7",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.20.2",
    "@babel/runtime": "^7.28.4",
    "dotenv-cli": "^6.0.0"
  },
  "volta": {
    "node": "22.21.1"
  }
}
